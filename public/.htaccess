# Force a single canonical origin: https://codelaksh.in (no www, no http).
# Fixes Search Console "Alternate page with proper canonical tag" for http:// and www. URLs.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # City renamed in URL: old /locations/aurangabad -> new slug
  RewriteRule ^locations/aurangabad/?$ https://codelaksh.in/locations/chhatrapati-sambhajinagar [L,R=301]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://codelaksh.in%{REQUEST_URI} [L,R=301]
</IfModule>

# Android App Links / Digital Asset Links: Google requires this file to be served as application/json.
<Files "assetlinks.json">
  ForceType application/json
</Files>
